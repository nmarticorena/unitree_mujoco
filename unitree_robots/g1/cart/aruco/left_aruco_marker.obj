# Generated UV-mapped ArUco marker; outward normal is local +Z.
mtllib left_aruco_marker.mtl
o left_aruco_marker

v -0.025 -0.025 0.0051
v  0.025 -0.025 0.0051
v  0.025  0.025 0.0051
v -0.025  0.025 0.0051

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vn 0.0 0.0 1.0

usemtl left_aruco_marker_material
s off
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
